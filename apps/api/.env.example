# Copy to apps/api/.env (never commit .env)

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-dev-only-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
LOG_LEVEL=INFO

# Control-plane MySQL only. Do not point this at a tenant business schema.
CONTROL_PLANE_DB_HOST=127.0.0.1
CONTROL_PLANE_DB_PORT=3306
CONTROL_PLANE_DB_NAME=vokit_control
CONTROL_PLANE_DB_USER=vokit
CONTROL_PLANE_DB_PASSWORD=vokit_local

REDIS_URL=redis://127.0.0.1:6379/0

# Tenant data-plane MySQL (one database per Agency).
# Super Admin supplies per-agency username/password at create; admin env only for CREATE/GRANT.
TENANT_RUNTIME=mysql
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_ADMIN_USER=root
TENANT_DB_ADMIN_PASSWORD=root_password
TENANT_DB_ADMIN_PASSWORD_REF=TENANT_DB_ADMIN_PASSWORD
# Demo seed only (seed_phase4_lifecycle). New agencies allocate vokit_t_<uuid-hex>.
TENANT_DB_NAME_A=vokit_tenant_a
TENANT_DB_NAME_B=vokit_tenant_b
TENANT_TLS_REQUIRED=false
TENANT_POOL_MAX_PER_TENANT=4
TENANT_POOL_MAX_ACTIVE_TENANTS=16
# Deprecated: do not use TENANT_DB_USER / TENANT_DB_PASSWORD for tenant runtime login.

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Agency KYC provider (secret refs only; never put keys in React)
KYC_PROVIDER=external
KYC_API_KEY_REF=KYC_API_KEY
KYC_WEBHOOK_SECRET_REF=KYC_WEBHOOK_SECRET
KYC_API_KEY=local-dev-kyc-key
KYC_WEBHOOK_SECRET=local-dev-kyc-webhook
KYC_HOSTED_BASE_URL=https://kyc.example.test

# Billing processor webhook secrets (secret refs only; never send to React)
BILLING_STRIPE_WEBHOOK_SECRET_REF=STRIPE_WEBHOOK_SECRET
BILLING_BRAINTREE_WEBHOOK_SECRET_REF=BRAINTREE_WEBHOOK_SECRET
STRIPE_WEBHOOK_SECRET=local-dev-stripe-webhook
BRAINTREE_WEBHOOK_SECRET=local-dev-braintree-webhook

# Knowledge vectors (empty URL uses in-process memory store)
QDRANT_URL=
QDRANT_COLLECTION=vokit_knowledge

# Phone-number reservation window (Q-002)
NUMBER_RESERVATION_SECONDS=600

# Internal Pipecat / Asterisk / DID-resolve token (never send to React).
# MUST match packages/pipecat-voice/.env and Asterisk AGI/curl Authorization.
VOKIT_INTERNAL_TELEPHONY_TOKEN=change-me-internal-telephony-secret
# Media WS token for sip-edge → Pipecat (never send to React).
# MUST match packages/vokit-sip-edge/.env SIP_NODE_MEDIA_BASE_URL media_token
# and packages/pipecat-voice/.env VOKIT_MEDIA_WS_TOKEN.
VOKIT_MEDIA_WS_TOKEN=change-me-media-ws-secret
# Recording plane service token (separate from telephony; never send to React)
VOKIT_INTERNAL_RECORDING_TOKEN=
RECORDING_ACCESS_TTL_SECONDS=60
RECORDING_PUBLIC_BASE_URL=https://recordings.vokit.test
RECORDING_DEFAULT_RETENTION_DAYS=30
INTEGRATION_ALLOW_HTTP=false
DEFAULT_FROM_EMAIL=noreply@vokit.test
# SMTP (Django). Password via secret ref — never commit real credentials.
# With CELERY_TASK_ALWAYS_EAGER=true (local default), email runs inline.
# For real queue: Redis up, CELERY_TASK_ALWAYS_EAGER=0, run celery worker.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD_REF=EMAIL_HOST_PASSWORD
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Lab voice: point Django at Windows sip-edge control HTTP.
# Empty uses in-process MemorySipEdge (unit tests). Lab: http://127.0.0.1:8090
SIP_EDGE_CONTROL_URL=http://127.0.0.1:8090
VOICE_STT_PROVIDER=
VOICE_STT_API_KEY_REF=VOICE_STT_API_KEY
VOICE_TTS_PROVIDER=
VOICE_TTS_API_KEY_REF=VOICE_TTS_API_KEY
VOICE_LLM_PROVIDER=
VOICE_LLM_API_KEY_REF=VOICE_LLM_API_KEY
# VOKIT_MEDIA_WS_TOKEN=
# Lab defaults on; production.py forces these off.
LIVE_FLAGS_ENABLED_BY_DEFAULT=true
BILLING_PROCESSOR_MODE=sandbox
# Dated YYYY-MM-DD attestations only. VOKIT_LAUNCH_GO=1 is not evidence.
# VOKIT_EVIDENCE_LIVE_INBOUND_CALL=
# VOKIT_EVIDENCE_LIVE_OUTBOUND_CALL=
# VOKIT_EVIDENCE_LIVE_PAYMENT=
# VOKIT_EVIDENCE_LIVE_RECORDING=
# VOKIT_EVIDENCE_RESTORE_DRILL=
# VOKIT_EVIDENCE_ALERTING=
# VOKIT_EVIDENCE_ROLLBACK_STAGING=
# VOKIT_EVIDENCE_LEGAL_SIGN_OFF=
