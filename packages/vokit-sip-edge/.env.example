# =============================================================================
# vokit-sip-edge — copy to packages/vokit-sip-edge/.env (gitignored)
# =============================================================================
# The edge loads this file automatically on startup when you run from repo root:
#   cd <repo-root>
#   .\packages\vokit-sip-edge\target\release\vokit-sip-edge.exe   # Windows
#   ./packages/vokit-sip-edge/target/release/vokit-sip-edge       # Linux VPS
# It also accepts a root .env. Django does NOT read this file.
# media_token MUST equal application/.env → VOKIT_MEDIA_WS_TOKEN
#
# Guides:
#   VMware lab:  docs/vmware-lab-inbound.md  + deploy/asterisk/lab/
#   Colocated VPS / staging: docs/lab-inbound-voice.md + deploy/asterisk/*.conf
# =============================================================================

# -----------------------------------------------------------------------------
# A) VMware lab defaults (Asterisk on VM, edge on Windows host)
#    Uncomment / use these when following docs/vmware-lab-inbound.md
# -----------------------------------------------------------------------------
SIP_TRUNK_HOST=192.168.56.100
SIP_TRUNK_PORT=5070
SIP_TRUNK_TRANSPORT=udp
# Edge SIP bind — 0.0.0.0 so the VM can Dial the edge on the Windows host
SIP_LOCAL_BIND=0.0.0.0:5071
SIP_PUBLIC_IP=192.168.56.1
SIP_DEFAULT_FROM=+15550001001
# SIP_DOMAIN=192.168.56.1

# -----------------------------------------------------------------------------
# B) Colocated VPS / staging (Asterisk + edge on same Linux host)
#    Comment block A and use these instead when deploying to a real trunk VPS:
#
# SIP_TRUNK_HOST=127.0.0.1
# SIP_TRUNK_PORT=5070
# SIP_TRUNK_TRANSPORT=udp
# SIP_LOCAL_BIND=127.0.0.1:5071
# SIP_PUBLIC_IP=YOUR_VPS_PUBLIC_IP
# SIP_DEFAULT_FROM=17134700972
# -----------------------------------------------------------------------------

SIP_CODECS=pcmu
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000
SIP_EDGE_HTTP_PORT=8090

# Phase 13 default: Pipecat peer on :8100 (packages/pipecat-voice)
# media_token MUST equal application/.env → VOKIT_MEDIA_WS_TOKEN
SIP_NODE_MEDIA_BASE_URL=ws://127.0.0.1:8100/sip/media?media_token=change-me-media-ws-secret
# Legacy rollback — Django Channels peer:
# SIP_NODE_MEDIA_BASE_URL=ws://127.0.0.1:8000/sip/media?media_token=change-me-media-ws-secret

# SIP_NODE_EVENTS_URL=
