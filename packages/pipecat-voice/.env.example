# =============================================================================
# vokit-pipecat-voice — copy to packages/pipecat-voice/.env (gitignored)
# media_token MUST equal application/.env → VOKIT_MEDIA_WS_TOKEN
# internal token MUST equal application/.env → VOKIT_INTERNAL_TELEPHONY_TOKEN
# =============================================================================

VOKIT_MEDIA_WS_TOKEN=change-me-media-ws-secret
VOKIT_INTERNAL_TELEPHONY_TOKEN=change-me-internal-telephony-secret
DJANGO_INTERNAL_BASE_URL=http://127.0.0.1:8000

PIPECAT_HOST=0.0.0.0
PIPECAT_PORT=8100
PIPECAT_HEARTBEAT_SECONDS=2

# Empty = allow telephony clients without Origin (Rust edge).
PIPECAT_ALLOWED_ORIGINS=

# Phase 14 — same Qdrant as Django. Empty disables hot-path retrieve.
QDRANT_URL=http://127.0.0.1:6333

