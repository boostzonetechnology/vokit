# Repo-wide ignores (application/ and packages/vokit-sip-edge/ also have local .gitignore)

# Secrets — never commit real env files (examples like .env.example are OK)
.env
**/.env
!**/.env.example
# .cursor/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Rust (if building from repo root)
**/target/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
db.sqlite3

# Node / React portals
node_modules/
dist/
*.tsbuildinfo
